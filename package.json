{
  "name": "notes-for-windows",
  "version": "1.1.7",
  "private": true,
  "description": "A thoughtfully familiar, local-first notes app for Windows.",
  "main": "electron/main.cjs",
  "author": "Vishaljani21",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "start": "npm run build && electron .",
    "build": "node scripts/prepare-assets.cjs && vite build",
    "dist": "npm run build && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "pack": "npm run build && electron-builder --win dir --x64 --config.electronDist=node_modules/electron/dist",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "predev": "node scripts/prepare-assets.cjs"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@playwright/test": "^1.55.1",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-details": "^3.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.2.7",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1",
    "vite": "^6.3.6"
  },
  "build": {
    "appId": "com.notesforwindows.desktop",
    "productName": "Notes for Windows",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icons/notes-original.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "public/icon.ico"
    },
    "nsis": {
      "include": "scripts/installer-icons.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Notes-for-Windows-Setup-${version}.${ext}"
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vishaljani21/notes-for-windows.git"
  },
  "homepage": "https://github.com/Vishaljani21/notes-for-windows",
  "bugs": {
    "url": "https://github.com/Vishaljani21/notes-for-windows/issues"
  }
}
